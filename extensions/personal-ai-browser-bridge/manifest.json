{
  "manifest_version": 3,
  "name": "Personal AI Browser Bridge",
  "version": "0.1.0",
  "description": "Tab-scoped browser primitives for the local personal agent.",
  "minimum_chrome_version": "106",
  "permissions": ["tabs", "scripting", "debugger", "nativeMessaging", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service_worker.js", "type": "module"},
  "action": {"default_title": "Connect Personal AI Browser Bridge"}
}
