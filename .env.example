# Copy only the values you need into .env.
# Never commit your real .env.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

JARVIS_INPUT_DEVICE=1
JARVIS_OUTPUT_DEVICE=5

JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
# Current V1 is French-first for reliable short commands.
# We will add explicit multilingual switching later.
JARVIS_STT_LANGUAGE=fr
JARVIS_STT_COMMAND_RETRY_LANGUAGE=fr

# More sensitive adaptive speech capture. These are the current defaults.
JARVIS_SPEECH_MIN_RMS=0.006
JARVIS_SPEECH_THRESHOLD_MULTIPLIER=2.2
JARVIS_SPEECH_PRE_ROLL_S=0.60
JARVIS_SPEECH_STARTUP_GRACE_S=0.12
JARVIS_SPEECH_SILENCE_S=0.80
JARVIS_SPEECH_MIN_VOICED_S=0.28
JARVIS_TTS_SETTLE_S=0.30

JARVIS_WAKE_RESPONSE=Oui monsieur ?
JARVIS_UI_FULLSCREEN=0

# Local AI brain
JARVIS_AI_PROVIDER=ollama
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=gemma3:latest
JARVIS_AI_REQUEST_TIMEOUT_S=60
JARVIS_AI_HISTORY_MESSAGES=8

# Once awakened, Jarvis keeps listening for follow-up requests for this long.
JARVIS_CONVERSATION_FOLLOWUP_TIMEOUT_S=10
JARVIS_STT_RETRY_LANGUAGE_PROBABILITY=0.65
