# Copy only the values you need into .env.
# Never commit your real .env.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

JARVIS_INPUT_DEVICE=1
JARVIS_OUTPUT_DEVICE=5

JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
# French-first for the current development phase.
# Set JARVIS_STT_LANGUAGE=auto later to re-enable automatic FR/EN/AR detection.
JARVIS_STT_LANGUAGE=fr
JARVIS_STT_SUPPORTED_LANGUAGES=fr,en,ar
JARVIS_STT_LANGUAGE_CONFIDENCE=0.72

# More sensitive adaptive speech capture. These are the current defaults.
JARVIS_SPEECH_MIN_RMS=0.006
JARVIS_SPEECH_THRESHOLD_MULTIPLIER=2.2
JARVIS_SPEECH_PRE_ROLL_S=0.60
JARVIS_SPEECH_STARTUP_GRACE_S=0.12
JARVIS_SPEECH_SILENCE_S=0.80
JARVIS_SPEECH_MIN_VOICED_S=0.28
JARVIS_TTS_SETTLE_S=0.30

JARVIS_WAKE_RESPONSE=Oui monsieur ?
JARVIS_UI_FULLSCREEN=0

# Local AI brain
JARVIS_AI_PROVIDER=ollama
JARVIS_PLANNER_PROVIDER=ollama
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=gemma3:latest

# Local visual fallback used only when UI Automation is ambiguous/incomplete.
# Screenshots stay in memory unless JARVIS_VISION_SAVE_EVIDENCE=1.
JARVIS_VISION_ENABLED=0
JARVIS_VISION_MODEL=gemma3:latest
JARVIS_VISION_TIMEOUT_S=20
JARVIS_VISION_MAX_WIDTH=1600
JARVIS_VISION_LOCAL_ONLY=1
# Visual mouse actions are a separate opt-in capability.
JARVIS_VISION_ACTIONS_ENABLED=0
JARVIS_VISION_MIN_CONFIDENCE=0.72
JARVIS_VISION_SAVE_EVIDENCE=0
JARVIS_VISION_EVIDENCE_MAX_FILES=30

JARVIS_AI_REQUEST_TIMEOUT_S=60
JARVIS_AI_HISTORY_MESSAGES=8

# Once awakened, Jarvis keeps listening for follow-up requests for this long.
JARVIS_CONVERSATION_FOLLOWUP_TIMEOUT_S=20
JARVIS_CONFIRMATION_TIMEOUT_S=15
JARVIS_STT_RETRY_LANGUAGE_PROBABILITY=0.65


# Model-native Agent Runtime (V2)
# Default: local tool-calling model through Ollama.
JARVIS_AGENT_PROVIDER=ollama
JARVIS_OLLAMA_AGENT_MODEL=qwen3:4b-instruct
JARVIS_OLLAMA_AGENT_TIMEOUT_S=90
JARVIS_OLLAMA_AGENT_NUM_CTX=4096
JARVIS_OLLAMA_AGENT_NUM_PREDICT=160
JARVIS_OLLAMA_AGENT_KEEP_ALIVE=30m
JARVIS_AGENT_MAX_TOOL_ROUNDS=8
JARVIS_AGENT_HISTORY_ITEMS=8
JARVIS_AGENT_HISTORY_TURNS=20

# Compatibility baseline: reproduces the pre-skills agent behavior.
# Keep this at 1 while validating the historical test battery.
JARVIS_COMPATIBILITY_BASELINE=1
JARVIS_OPERATIONAL_LEARNING_ENABLED=0
JARVIS_STRICT_PROOF_ENABLED=0
JARVIS_FOCUSED_TYPING_FALLBACK_ENABLED=0

# Opt-in generic Computer Use Engine V2. Baseline=1 always disables it.
# See docs/COMPUTER_USE_ENGINE_V2.md and scripts/run_jarvis_computer_use.ps1.
JARVIS_COMPUTER_USE_ENABLED=0
JARVIS_UI_MAX_ACTIONS=24
JARVIS_UI_MAX_OBSERVATIONS=36
JARVIS_UI_MISSION_TIMEOUT_S=240
JARVIS_UI_TARGET_MAX_AGE_S=30
JARVIS_VISION_SCHEMA_ENABLED=0
JARVIS_VISION_GROUNDING_ENABLED=0
# Empty uses JARVIS_VISION_MODEL; must support the documented 0..1000 box contract.
JARVIS_VISION_GROUNDING_MODEL=
JARVIS_BROWSER_ENABLED=0
# Attach only to an explicitly configured CDP session; never auto-discover profiles.
JARVIS_BROWSER_CDP_URL=

# Optional structured Windows computer-use fallback.
# If cua-driver is installed, Jarvis uses it only when its pywinauto/UIA
# observation is too sparse. It keeps one persistent local MCP process so
# element tokens remain tied to the observation that produced them.
JARVIS_CUA_DRIVER_ENABLED=0
JARVIS_CUA_DRIVER_BINARY=
JARVIS_CUA_DRIVER_TIMEOUT_S=6

# AIOS-inspired foundations. Kept OFF while historical/live behavior is
# validated. These flags do not change routing/tools until explicitly wired.
JARVIS_STRUCTURED_TRACING_ENABLED=0
JARVIS_MODEL_TELEMETRY_ENABLED=0
JARVIS_AGENT_REGISTRY_ENABLED=0
JARVIS_DEV_SUPERVISOR_ENABLED=0

# First safe convergence step: mirror completed live turns into an isolated
# passive Kernel store. OFF by default; it never dispatches tools or overrides
# the authoritative live runtime.
JARVIS_KERNEL_SHADOW_ENABLED=0
JARVIS_KERNEL_SHADOW_DIR=
JARVIS_KERNEL_SHADOW_USER_ID=local-user

# Groq cloud brain (recommended for fast agentic tool use)
# Create GROQ_API_KEY in Groq Console and keep it only in .env.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
JARVIS_GROQ_AGENT_MODEL=openai/gpt-oss-120b
JARVIS_GROQ_REASONING_EFFORT=low
JARVIS_GROQ_BROWSER_SEARCH=1

# Cerebras cloud brain (very high free-tier TPM for GPT-OSS 120B)
# Create CEREBRAS_API_KEY in Cerebras Cloud and keep it only in .env.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_SECONDARY_API_KEY=
CEREBRAS_SECONDARY_BASE_URL=https://api.cerebras.ai/v1
JARVIS_CEREBRAS_AGENT_MODEL=gpt-oss-120b
JARVIS_CEREBRAS_REASONING_EFFORT=low
JARVIS_CEREBRAS_REQUEST_TIMEOUT_S=8
JARVIS_CEREBRAS_FALLBACK_TO_GROQ=1

# Optional cloud brain. Keep OPENAI_API_KEY only in .env, never commit it.
# Set JARVIS_AGENT_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_AGENT_MODEL=gpt-6-astra
JARVIS_OPENAI_REASONING_EFFORT=low
JARVIS_OPENAI_WEB_SEARCH=1

# Optional MCP/plugin-style connectors for the OpenAI/Astra provider.
# Copy connectors.example.json to connectors.local.json and configure only
# trusted servers. Tokens stay in .env through each connector's
# authorization_env field; never put OAuth/access tokens in the JSON file.
JARVIS_CONNECTORS_FILE=
EXAMPLE_MCP_TOKEN=

# MS Football local app-specific agent bridge
# Use the SAME strong random token in Jarvis and in ms_football_gest.
JARVIS_MS_FOOTBALL_BRIDGE_URL=http://127.0.0.1:8765
JARVIS_MS_FOOTBALL_BRIDGE_TOKEN=
